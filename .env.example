# =============================================================
# Server
# =============================================================
PORT=8000
APP_URL=http://localhost:8000
WEB_APP_URL=http://localhost:5173
NODE_ENV=development

# =============================================================
# Database
# =============================================================
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app_dev
DB_PORT=5432

# =============================================================
# Redis
# =============================================================
REDIS_URL=redis://localhost:6379

# =============================================================
# Auth
# =============================================================
SESSION_SECRET=change-me-to-a-random-32-char-string
JWT_SECRET=change-me-to-another-random-32-char-string

# Google OAuth (optional — enables Sign in with Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =============================================================
# Stripe
# =============================================================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs — create these in your Stripe dashboard
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...

# =============================================================
# File storage — Cloudflare R2
# =============================================================
# On the alchemist platform these are injected automatically by the
# rollout controller from the alchemist-customer-platform-creds K8s
# secret + a per-customer R2_KEY_PREFIX. Locally, point at any S3-
# compatible bucket — leave R2_KEY_PREFIX empty for single-tenant
# local mode (no isolation).
#
# Cross-tenant isolation: src/services/storage.service.ts auto-
# prefixes every key with R2_KEY_PREFIX. Application code passes
# RELATIVE keys (e.g. `images/avatar.jpg`); the prefix is prepended
# in the service. There is no way for app code to escape the prefix
# using the helpers (scopedKey() rejects empty/leading-slash/`..`).
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_KEY_PREFIX=

# Legacy GCS — only set if the agent specifically wired GCS instead
# of R2 (rare; R2 is the default). Leave blank otherwise.
GCS_PROJECT_ID=
GCS_KEY_FILE=
GCS_BUCKET=

# =============================================================
# Email (optional — enables transactional email)
# =============================================================
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@yourdomain.com

# =============================================================
# Cloudflare (optional — enables custom domain support)
# =============================================================
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=
