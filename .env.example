# =============================================================
# Server
# =============================================================
PORT=8000
APP_URL=http://localhost:8000
WEB_APP_URL=http://localhost:5173
NODE_ENV=development

# Dev-only routes (/api/dev/*: instant login, DB seed/reset) + the
# in-memory dev-activity ring buffers. FAIL CLOSED: off unless this is
# explicitly "1" or "true". Never set this in production / customer
# deploys. The `deno task dev` task sets it automatically for local dev.
ALCHEMIST_DEV_ROUTES=1

# =============================================================
# Database
# =============================================================
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app_dev
DB_PORT=5432

# =============================================================
# Redis
# =============================================================
REDIS_URL=redis://localhost:6379

# =============================================================
# Auth
# =============================================================
SESSION_SECRET=change-me-to-a-random-32-char-string
JWT_SECRET=change-me-to-another-random-32-char-string

# Google OAuth (optional — enables Sign in with Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =============================================================
# Stripe
# =============================================================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs — create these in your Stripe dashboard.
# These are ONLY for the org PLAN-TIER subscription (PRO monthly/yearly).
# Products you sell in-app (one-time or recurring) need NO env config —
# the product catalog (Settings -> Billing -> "New product") creates
# Stripe Products/Prices via the API automatically.
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...

# =============================================================
# File storage — Cloudflare R2
# =============================================================
# On the alchemist platform these are injected automatically by the
# rollout controller from the alchemist-customer-platform-creds K8s
# secret + a per-customer R2_KEY_PREFIX. Locally, point at any S3-
# compatible bucket — leave R2_KEY_PREFIX empty for single-tenant
# local mode (no isolation).
#
# Cross-tenant isolation: src/services/storage.service.ts auto-
# prefixes every key with R2_KEY_PREFIX. Application code passes
# RELATIVE keys (e.g. `images/avatar.jpg`); the prefix is prepended
# in the service. There is no way for app code to escape the prefix
# using the helpers (scopedKey() rejects empty/leading-slash/`..`).
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_KEY_PREFIX=

# Legacy GCS — only set if the agent specifically wired GCS instead
# of R2 (rare; R2 is the default). Leave blank otherwise.
GCS_PROJECT_ID=
GCS_KEY_FILE=
GCS_BUCKET=

# =============================================================
# Background jobs (scheduled jobs + email outbox delivery)
# =============================================================
# The in-process runner (src/jobs/runner.ts) ticks on every replica;
# row claims are SKIP LOCKED so replicas never double-run. Set
# JOBS_ENABLED=0 on a pod that must not do background work.
JOBS_ENABLED=1
JOBS_TICK_MS=30000
# Reject schedules tighter than this many seconds (default 300).
JOBS_MIN_INTERVAL_SECONDS=300
# A handler running longer than this is abandoned and marked failed.
JOBS_HANDLER_TIMEOUT_MS=60000

# =============================================================
# Email (optional — enables transactional email)
# =============================================================
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@yourdomain.com
# The platform's provider-VERIFIED sender. Injected automatically on a hosted
# deployment; set it locally only if you want to exercise the fallback. When a
# send is refused because EMAIL_FROM's domain is not verified with the mail
# provider, AUTH-CRITICAL mail (the OTP login code, an invite link) retries once
# from this address so a branding misconfiguration cannot lock users out.
PLATFORM_EMAIL_FROM=

# =============================================================
# Cloudflare (optional — enables custom domain support)
# =============================================================
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=

# =============================================================
# Durable events (src/lib/events.ts, src/jobs/event-consumer.ts)
# =============================================================
# Shared secret gating POST /api/events/inbox (platform and relay
# deliveries into this project's event log, HMAC-SHA256 over the raw
# body plus a timestamp). Unset = the inbox fails closed (401s
# everything). The platform injects this when it provisions the
# project.
EVENTS_INBOX_SECRET=
# Replay window for inbox signatures, in seconds (default 300).
EVENTS_INBOX_TOLERANCE_S=300
# Consumer tuning (defaults shown; read per tick, no restart needed).
EVENTS_POLL_INTERVAL_MS=5000
EVENTS_BATCH_SIZE=25
EVENTS_CONCURRENCY=4
EVENTS_HANDLER_TIMEOUT_MS=30000
# Tick lock TTL. Kept short and refreshed while a tick runs, so a pod
# that dies mid-tick stalls its peers for this long at most.
EVENTS_LOCK_TTL_S=60
# Floored in code to ceil(batch/concurrency) * (timeout + 5s) + 60s;
# a lower value is raised and logged at boot.
EVENTS_STALE_CLAIM_MS=600000
# Retention: done deliveries and events older than these are deleted
# by the hourly sweep (0 disables that half).
EVENTS_RETENTION_DELIVERIES_DAYS=7
EVENTS_RETENTION_EVENTS_DAYS=90
EVENTS_RETENTION_SWEEP_MS=3600000
# Outbound webhook signing secrets are env vars named by each
# subscription's secret_ref (any UPPER_SNAKE_CASE name you choose).

# =============================================================
# Inbound email ingestion (optional -- dormant until configured)
# =============================================================
# Shared secret gating POST /api/ingest/email (the Postmark inbound
# webhook). The platform mints + injects this when it provisions an
# ingestion address for the project. Unset = endpoint fails closed
# (401s everything).
INGEST_EMAIL_TOKEN=
# Organization UUID captured emails are attributed to. Unset = rows
# are stored with organization_id NULL (invisible in the dashboard,
# which is org-scoped). Set this in production.
INGEST_ORG_ID=
# Background extraction reaper tuning (defaults shown). Extraction
# also requires the platform-injected LLM proxy credentials
# (LLM_PROXY_BASE_URL / WORKER_LLM_PROXY_TOKEN / LLM_PROXY_TENANT_ID).
INBOUND_EMAIL_POLL_INTERVAL_MS=60000
INBOUND_EMAIL_BATCH_SIZE=5
INBOUND_EMAIL_RETRY_AFTER_MS=1800000

# =============================================================
# Scheduled expiration digest (optional -- dormant until a provider
# is registered; see src/services/expiration-digest.ts)
# =============================================================
# Defaults shown. The job stays dormant with no expiring-records
# provider registered, whatever these are set to.
EXPIRATION_DIGEST_INTERVAL_MS=86400000
EXPIRATION_DIGEST_WITHIN_DAYS=30
