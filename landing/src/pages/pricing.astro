---
import Layout from "../layouts/Layout.astro";
import { site } from "../lib/site";

const title = `${site.name} pricing`;
const description = `${site.pricing.answer} Prices as of ${site.asOf}.`;
---
<Layout title={title} description={description} path="/pricing/">
  <article class="page wrap narrow">
    <header>
      <h1>{site.name} pricing</h1>
      <p class="muted">{site.definition.what}</p>
    </header>

    <section aria-labelledby="main-question">
      <h2 id="main-question">{site.pricing.question}</h2>
      <p>{site.pricing.answer}</p>
      <p class="as-of">Prices as of {site.asOf}.</p>
    </section>

    {site.pricing.plans.length > 0 && (
      <section aria-labelledby="plans">
        <h2 id="plans">Plans</h2>
        <ul class="grid">
          {site.pricing.plans.map((plan) => (
            <li class="card">
              <h3>{plan.name}</h3>
              <p><strong>{plan.price}</strong>{plan.period ? ` ${plan.period}` : ""}</p>
              <p>{plan.description}</p>
              {plan.features.length > 0 && (
                <ul>
                  {plan.features.map((feature) => <li>{feature}</li>)}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </section>
    )}

    <p><a class="button" href={site.cta.href}>{site.cta.label}</a></p>
  </article>
</Layout>
