---
// The home page. Order matters for answer engines: the H1, then the reader's
// main question as the first H2, then a short honest answer.
import Layout from "../layouts/Layout.astro";
import { site } from "../lib/site";

const title = `${site.name}: what it is, who it is for, and what it does`;
---
<Layout title={title} description={site.description} path="/" faq={site.faq}>
  <article>
    <header>
      <h1>{site.name}</h1>
      <p>{site.definition.what}</p>
      <p><a class="button" href={site.cta.href}>{site.cta.label}</a></p>
    </header>

    <section aria-labelledby="main-question">
      <h2 id="main-question">{site.mainQuestion}</h2>
      <p>{site.itDependsAnswer}</p>
    </section>

    <section aria-labelledby="definition">
      <h2 id="definition">What is {site.name}?</h2>
      <dl>
        <dt>What it is</dt>
        <dd>{site.definition.what}</dd>
        <dt>Who it is for</dt>
        <dd>{site.definition.who}</dd>
        <dt>What it does</dt>
        <dd>{site.definition.does}</dd>
      </dl>
      <p class="as-of">As of {site.asOf}.</p>
    </section>

    {site.features.length > 0 && (
      <section aria-labelledby="features">
        <h2 id="features">What can you do with {site.name}?</h2>
        <ul class="grid">
          {site.features.map((f) => (
            <li class="card">
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </li>
          ))}
        </ul>
        <p class="as-of">Features as of {site.asOf}.</p>
      </section>
    )}

    {site.testimonials.length > 0 && (
      <section aria-labelledby="testimonials">
        <h2 id="testimonials">What do customers say?</h2>
        <ul class="grid">
          {site.testimonials.map((t) => (
            <li class="card">
              <figure>
                <blockquote><p>{t.quote}</p></blockquote>
                <figcaption>{t.name}{t.role ? `, ${t.role}` : ""}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </section>
    )}

    {site.faq.length > 0 && (
      <section aria-labelledby="faq">
        <h2 id="faq">Frequently asked questions</h2>
        {site.faq.map((f) => (
          <div>
            <h3>{f.question}</h3>
            <p>{f.answer}</p>
          </div>
        ))}
      </section>
    )}
  </article>
</Layout>
