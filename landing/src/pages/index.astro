---
// The home page "/". A composed page for "/" (src/content/pages/) replaces
// the classic home page built from site.json, and makes the whole site
// composed (lib/composed.ts).
import ComposedPage from "../components/ComposedPage.astro";
import Home from "../components/legacy/Home.astro";
import { composedPageAt } from "../lib/content";

const home = composedPageAt("/");
---
{home ? <ComposedPage page={home} /> : <Home />}
