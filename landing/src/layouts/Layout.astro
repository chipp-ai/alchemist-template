---
/**
 * The one layout every landing page uses: header with nav, main, footer.
 * It prints the visible Published and Updated dates and the JSON-LD.
 * See landing/README.md for the AEO rules.
 *
 * The look comes from ../web/src/design/design.json (loadBrand), so the
 * landing site matches the app. src/styles/theme.css loads after these
 * styles and may override any token.
 */
import { absoluteUrl, formatDate, jsonLd, loadBrand, scriptJson, site, type SiteFaq } from "../lib/site";
import "../styles/theme.css";
import { customCode, footerLinks, headerLinks } from "../lib/content";
import type { PageSeo } from "../lib/composed";

interface Props {
  /** The <title>. */
  title: string;
  /** The meta description. "" prints none. */
  description: string;
  /** This page's path, e.g. "/pricing/". */
  path: string;
  /** The FAQ this page shows, so the FAQPage JSON-LD matches it. */
  faq?: SiteFaq[];
  /** Composed pages and posts: canonical, Open Graph, noindex and carried JSON-LD. */
  seo?: PageSeo;
  /** Composed pages and posts: the page's own JSON-LD graph instead of the classic one. */
  ld?: object;
  /** Extra JSON-LD objects to print after the page's own (from the old site). */
  extraLd?: object[];
  /** "article" for blog posts. */
  ogType?: string;
  /**
   * "relaxed" for words carried over from an old site and for blog posts:
   * the AEO check reports the content-shape rules as warnings.
   */
  aeo?: "relaxed";
}

const { title, description, path, faq, seo, ld: pageLd, extraLd = [], ogType, aeo } = Astro.props;
const brand = loadBrand();
const weights = [...new Set([brand.bodyWeight, 600, brand.headingWeight, 700])].sort((a, b) => a - b).join(";");
const families = [...new Set([brand.headingFont, brand.bodyFont])]
  .map((f) => `family=${encodeURIComponent(f).replace(/%20/g, "+")}:wght@${weights}`)
  .join("&");
const fontsHref = `https://fonts.googleapis.com/css2?${families}&display=swap`;
const ld = scriptJson(pageLd ?? jsonLd({ path, title, description, faq }));
const extraLdJson = extraLd.map((x) => scriptJson(x));
const canonicalSource = seo?.canonical?.trim();
const canonical = canonicalSource && /^https?:\/\//i.test(canonicalSource)
  ? canonicalSource
  : site.url
  ? absoluteUrl(canonicalSource || path)
  : null;
const og = seo?.og ?? {};
const ogTitle = og.title ?? og["og:title"] ?? title;
const ogDescription = og.description ?? og["og:description"] ?? description;
const ogImageSource = og.image ?? og["og:image"] ?? site.productShot?.src;
const ogImage = ogImageSource ? (ogImageSource.startsWith("/") ? absoluteUrl(ogImageSource) : ogImageSource) : null;
const OG_HANDLED = new Set(["title", "description", "image", "type"]);
const ogExtra = Object.entries(og)
  .map(([k, v]) => [k.replace(/^og:/, ""), v] as const)
  .filter(([k, v]) => !OG_HANDLED.has(k) && typeof v === "string" && v.trim() !== "");
const year = site.updatedAt.slice(0, 4);
const navLinks = headerLinks();
const footLinks = footerLinks();
const customHead = customCode("head");
const customBodyEnd = customCode("bodyEnd");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {seo?.noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={ogTitle} />
    {ogDescription && <meta property="og:description" content={ogDescription} />}
    <meta property="og:type" content={og.type ?? og["og:type"] ?? ogType ?? "website"} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogExtra.map(([k, v]) => <meta property={`og:${k}`} content={v} />)}
    <meta property="article:published_time" content={site.publishedAt} />
    <meta property="article:modified_time" content={site.updatedAt} />
    <meta name="theme-color" content={brand.background} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontsHref} />
    <script type="application/ld+json" set:html={ld} />
    {extraLdJson.map((x) => <script type="application/ld+json" set:html={x} />)}
    <script is:inline>
      // Links sent before the app moved to /app (for example "/#/invite/x")
      // still open the right app page.
      (function () {
        var h = window.location.hash;
        if (h && h.indexOf("#/") === 0) window.location.replace("/app/" + h);
      })();
    </script>
    {customHead && <Fragment set:html={customHead} />}
    <style
      define:vars={{
        primary: brand.primary,
        primaryContrast: brand.primaryContrast,
        link: brand.link,
        accent: brand.accent,
        bg: brand.background,
        surface: brand.surface,
        text: brand.text,
        muted: brand.muted,
        tint: brand.tint,
        line: brand.line,
        shadowSm: brand.shadowSm,
        shadowMd: brand.shadowMd,
        shadowLg: brand.shadowLg,
        borderWidth: `${brand.borderWidth}px`,
        headingFont: `"${brand.headingFont}", ui-sans-serif, system-ui, sans-serif`,
        bodyFont: `"${brand.bodyFont}", ui-sans-serif, system-ui, sans-serif`,
        headingWeight: brand.headingWeight,
        headingTracking: `${brand.headingTracking}em`,
        headingCase: brand.headingCase === "upper" ? "uppercase" : "none",
        bodyWeight: brand.bodyWeight,
        radius: brand.radius,
      }}
      is:global
    >
      *, *::before, *::after { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      /* Mobile rules: web/DESIGN.md "Mobile and touch". */
      html { -webkit-tap-highlight-color: transparent; }
      html, body { overflow-x: clip; }
      a, button { touch-action: manipulation; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: var(--bodyFont);
        font-weight: var(--bodyWeight);
        font-size: 1.0625rem;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }
      h1, h2, h3 {
        font-family: var(--headingFont);
        font-weight: var(--headingWeight);
        letter-spacing: var(--headingTracking);
        text-transform: var(--headingCase);
        line-height: 1.15;
        margin: 0;
        text-wrap: balance;
      }
      h1 { font-size: clamp(2.25rem, 5.2vw, 3.75rem); line-height: 1.05; }
      h2 { font-size: clamp(1.625rem, 3vw, 2.25rem); }
      h3 { font-size: 1.125rem; line-height: 1.3; }
      p { margin: 0; text-wrap: pretty; }
      a { color: var(--link); text-underline-offset: 0.18em; }
      a:focus-visible, button:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; border-radius: 4px; }
      img { max-width: 100%; height: auto; display: block; }
      ul { margin: 0; padding: 0; list-style: none; }
      .wrap {
        width: 100%; max-width: 72rem; margin: 0 auto;
        padding: 0 max(1.25rem, env(safe-area-inset-right)) 0 max(1.25rem, env(safe-area-inset-left));
      }
      .narrow { max-width: 46rem; }
      .muted { color: var(--muted); }
      .skip { position: absolute; left: -999px; top: 0; }
      .skip:focus { left: 1rem; top: 1rem; z-index: 10; background: var(--surface); padding: 0.5rem 0.75rem; }

      /* Header */
      .site-header {
        position: sticky; top: 0; z-index: 5;
        padding-top: env(safe-area-inset-top);
        background: color-mix(in srgb, var(--bg) 88%, transparent);
        backdrop-filter: saturate(1.4) blur(10px);
        border-bottom: 1px solid var(--line);
      }
      .site-header .wrap { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 4rem; }
      .brand {
        display: inline-flex; align-items: center; gap: 0.6rem;
        font-family: var(--headingFont); font-weight: var(--headingWeight);
        letter-spacing: var(--headingTracking);
        color: var(--text); text-decoration: none; font-size: 1.125rem;
      }
      .brand-mark {
        width: 1.75rem; height: 1.75rem; border-radius: min(var(--radius), 8px);
        background: var(--primary); color: var(--primaryContrast);
        display: inline-grid; place-items: center; font-size: 0.95rem;
      }
      .site-nav ul { display: flex; align-items: center; gap: 0.25rem 1.25rem; flex-wrap: wrap; justify-content: flex-end; }
      .site-nav a { color: var(--text); text-decoration: none; font-size: 0.95rem; }
      .site-nav a[aria-current="page"] { color: var(--link); font-weight: 600; }

      /* Buttons */
      .button {
        display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
        min-height: 2.75rem; padding: 0.7rem 1.2rem;
        border-radius: var(--radius);
        border: var(--borderWidth) solid var(--primary);
        background: var(--primary); color: var(--primaryContrast);
        font-weight: 600; font-size: 1rem; text-decoration: none; line-height: 1.2;
        -webkit-user-select: none; user-select: none;
        box-shadow: var(--shadowSm);
        transition: transform 120ms ease, box-shadow 120ms ease;
      }
      .button:active { transform: translateY(0); opacity: 0.85; }
      .button.secondary { background: transparent; color: var(--text); border-color: var(--line); box-shadow: none; }
      .button.secondary:active { border-color: var(--text); }
      .site-nav .button { min-height: 2.25rem; padding: 0.45rem 0.9rem; font-size: 0.9rem; color: var(--primaryContrast); }
      .site-nav a:active { color: var(--link); }
      .site-nav .button:active { color: var(--primaryContrast); }
      @media (hover: hover) and (pointer: fine) {
        .site-nav a:hover { color: var(--link); }
        .button:hover { transform: translateY(-1px); box-shadow: var(--shadowMd); }
        .button.secondary:hover { border-color: var(--text); }
        .site-nav .button:hover { color: var(--primaryContrast); }
      }

      /* Sections */
      main { display: block; }
      .section { padding: clamp(3.5rem, 8vw, 6rem) 0; }
      .section + .section { border-top: 1px solid var(--line); }
      .section-head { max-width: 40rem; margin-bottom: 2.5rem; }
      .section-head p { margin-top: 0.75rem; color: var(--muted); font-size: 1.0625rem; }
      .kicker {
        display: inline-block; margin-bottom: 0.75rem;
        font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
        color: var(--muted);
      }
      .card {
        background: var(--surface); border-radius: var(--radius);
        border: var(--borderWidth) solid var(--line); padding: 1.5rem; box-shadow: var(--shadowSm);
      }
      .grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); }
      .as-of { font-size: 0.875rem; color: var(--muted); margin-top: 1.5rem; }
      .page-dates { font-size: 0.875rem; color: var(--muted); }
      dl { margin: 0; }
      dt { font-weight: 700; margin-top: 1rem; }
      dd { margin: 0.25rem 0 0; }
      blockquote { margin: 0; }

      /* Simple pages (pricing, about) */
      .page { padding: clamp(3rem, 7vw, 5rem) 0; }
      .page h1 { margin-bottom: 1rem; }
      .page h2 { margin: 2.5rem 0 0.75rem; font-size: 1.5rem; }
      .page p + p { margin-top: 0.75rem; }
      .page .grid { margin-top: 1rem; }
      .page .card ul { list-style: disc; padding-left: 1.25rem; margin-top: 0.75rem; }
      .page .card h3 + p { margin-top: 0.5rem; }
      .page > p:last-child .button { margin-top: 2rem; }

      /* Footer */
      .site-footer { border-top: 1px solid var(--line); padding: 2.5rem 0 3rem; font-size: 0.9375rem; background: var(--surface); }
      .site-footer .wrap { display: grid; gap: 1.5rem; grid-template-columns: 1fr auto; align-items: start; }
      .site-footer nav ul { display: flex; gap: 0.5rem 1.25rem; flex-wrap: wrap; }
      .site-footer a { color: var(--text); }
      .site-footer p + p { margin-top: 0.35rem; }

      @media (max-width: 40rem) {
        .site-nav .hide-sm { display: none; }
        .site-footer .wrap { grid-template-columns: 1fr; }
      }
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { transition: none !important; animation: none !important; }
      }
    </style>
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/"><span class="brand-mark" aria-hidden="true">{site.name.trim().charAt(0).toUpperCase()}</span>{site.name}</a>
        <nav class="site-nav" aria-label="Main">
          <ul>
            {navLinks.map((p) => (
              <li class="hide-sm"><a href={p.href} aria-current={p.href === path ? "page" : undefined}>{p.label}</a></li>
            ))}
            {site.cta?.label && site.cta?.href && <li><a class="button" href={site.cta.href}>{site.cta.label}</a></li>}
          </ul>
        </nav>
      </div>
    </header>
    <main id="content" data-aeo={aeo}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div>
          <p><strong>{site.name}</strong></p>
          <p class="muted">Facts on this site are current as of {site.asOf}.</p>
          <p class="page-dates">
            Published <time datetime={site.publishedAt}>{formatDate(site.publishedAt)}</time>.
            Updated <time datetime={site.updatedAt}>{formatDate(site.updatedAt)}</time>.
          </p>
          <p class="muted">&copy; {year} {site.name}</p>
        </div>
        <nav aria-label="Footer">
          <ul>
            {footLinks.map((p) => <li><a href={p.href}>{p.label}</a></li>)}
            {site.cta?.label && site.cta?.href && <li><a href={site.cta.href}>{site.cta.label}</a></li>}
          </ul>
        </nav>
      </div>
    </footer>
    {customBodyEnd && <Fragment set:html={customBodyEnd} />}
  </body>
</html>
