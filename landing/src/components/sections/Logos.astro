---
import type { LogosSection } from "../../lib/composed";
import Head from "./Head.astro";
import Img from "./Img.astro";

interface Props {
  section: LogosSection;
  level: "h1" | "h2";
  id: string;
}
const { section, level, id } = Astro.props;
---
<section class="section cs-logos-section" aria-labelledby={section.heading ? id : undefined}>
  <div class="wrap">
    <Head heading={section.heading} level={level} id={id} />
    <ul class="cs-logos">
      {section.logos.map((logo) => (
        <li>
          {logo.href ? <a href={logo.href}><Img image={logo} /></a> : <Img image={logo} />}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .cs-logos { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 1.5rem 2.5rem; }
  .cs-logos li { min-width: 0; }
  .cs-logos :global(img) { max-height: 3rem; width: auto; object-fit: contain; }
  .cs-logos a:active { opacity: 0.7; }
  @media (hover: hover) and (pointer: fine) {
    .cs-logos a:hover { opacity: 0.8; }
  }
</style>
