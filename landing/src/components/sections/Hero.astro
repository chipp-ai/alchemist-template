---
import type { HeroSection } from "../../lib/composed";
import Img from "./Img.astro";

interface Props {
  section: HeroSection;
  level: "h1" | "h2";
  id: string;
}
const { section, level, id } = Astro.props;
const Heading = level;
const actions = section.actions ?? [];
---
<section class="cs-hero" aria-labelledby={id}>
  <div class={section.image ? "wrap cs-hero-grid" : "wrap"}>
    <div class="cs-hero-copy">
      {section.eyebrow && <p class="kicker">{section.eyebrow}</p>}
      <Heading id={id}>{section.heading}</Heading>
      {section.subhead && <p class="cs-subhead">{section.subhead}</p>}
      {actions.length > 0 && (
        <div class="cs-actions">
          {actions.map((a, i) => <a class={i === 0 ? "button" : "button secondary"} href={a.href}>{a.label}</a>)}
        </div>
      )}
    </div>
    {section.image && (
      <figure class="cs-hero-media">
        <Img image={section.image} eager={level === "h1"} />
        {section.image.caption && <figcaption class="muted">{section.image.caption}</figcaption>}
      </figure>
    )}
  </div>
</section>

<style>
  .cs-hero { background: var(--tint); padding: clamp(3rem, 8vw, 6rem) 0; }
  .cs-hero-grid { display: grid; gap: 2.5rem; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); align-items: center; }
  .cs-hero-copy { min-width: 0; }
  .cs-hero-copy :is(h1, h2) { max-width: 20ch; }
  .cs-subhead { margin-top: 1.25rem; max-width: 38rem; font-size: clamp(1.0625rem, 1.6vw, 1.25rem); color: var(--muted); }
  .cs-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .cs-actions .button.secondary { background: var(--surface); }
  .cs-hero-media { margin: 0; min-width: 0; }
  .cs-hero-media :global(img) { width: 100%; border-radius: var(--radius); box-shadow: var(--shadowMd); }
  .cs-hero-media figcaption { margin-top: 0.5rem; font-size: 0.875rem; }
  @media (max-width: 52rem) {
    .cs-hero-grid { grid-template-columns: 1fr; }
  }
</style>
