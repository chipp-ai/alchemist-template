---
import type { FeaturesSection } from "../../lib/composed";
import Head from "./Head.astro";
import Img from "./Img.astro";

interface Props {
  section: FeaturesSection;
  level: "h1" | "h2";
  id: string;
}
const { section, level, id } = Astro.props;
---
<section class="section" aria-labelledby={section.heading ? id : undefined}>
  <div class="wrap">
    <Head heading={section.heading} intro={section.intro} level={level} id={id} />
    <ul class="cs-features">
      {section.items.map((item) => (
        <li>
          {item.image && <Img image={item.image} class="cs-feature-img" />}
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .cs-features { display: grid; gap: 2rem 2.5rem; grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr)); }
  .cs-features li { min-width: 0; padding-top: 1.25rem; border-top: 2px solid var(--line); }
  .cs-features h3 { margin-bottom: 0.5rem; }
  .cs-features p { color: var(--muted); }
  .cs-features :global(.cs-feature-img) { width: 100%; border-radius: var(--radius); margin-bottom: 1rem; }
</style>
