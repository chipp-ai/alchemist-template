---
import type { CtaSection } from "../../lib/composed";

interface Props {
  section: CtaSection;
  level: "h1" | "h2";
  id: string;
}
const { section, level, id } = Astro.props;
const Heading = level;
---
<section class="cs-cta" aria-labelledby={id}>
  <div class="wrap cs-cta-inner">
    <div>
      <Heading id={id}>{section.heading}</Heading>
      {section.body && <p>{section.body}</p>}
    </div>
    <a class="button cs-inverse" href={section.action.href}>{section.action.label}</a>
  </div>
</section>

<style>
  .cs-cta { background: var(--primary); color: var(--primaryContrast); padding: clamp(3rem, 7vw, 4.5rem) 0; }
  .cs-cta-inner { display: flex; align-items: center; justify-content: space-between; gap: 2rem; flex-wrap: wrap; }
  .cs-cta-inner > div { min-width: 0; }
  .cs-cta p { margin-top: 0.5rem; max-width: 40rem; opacity: 0.92; }
  .button.cs-inverse { background: var(--primaryContrast); color: var(--primary); border-color: var(--primaryContrast); }
</style>
