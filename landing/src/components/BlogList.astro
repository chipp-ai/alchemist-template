---
/** The blog list at site.json blog.path: every post, newest first. */
import Layout from "../layouts/Layout.astro";
import type { BlogSettings } from "../lib/composed";
import { posts } from "../lib/content";
import { composedPageLd } from "../lib/page-ld";
import { formatDate, site } from "../lib/site";
import PostList from "./PostList.astro";

interface Props {
  blog: BlogSettings;
}
const { blog } = Astro.props;
const newest = posts[0];
const updated = (newest?.updatedAt ?? newest?.date ?? site.updatedAt).slice(0, 10);
const published = (posts[posts.length - 1]?.date ?? site.publishedAt).slice(0, 10);
const ld = composedPageLd({ path: blog.path, title: blog.title, description: blog.description, published, updated, kind: "CollectionPage" });
---
<Layout title={blog.title} description={blog.description} path={blog.path} ld={ld} aeo="relaxed">
  <div class="page wrap narrow">
    <header>
      <h1>{blog.title}</h1>
      <p class="muted">{blog.description}</p>
      <p class="page-dates">
        Published <time datetime={published}>{formatDate(published)}</time>.
        Updated <time datetime={updated}>{formatDate(updated)}</time>.
      </p>
    </header>
    <PostList posts={posts} />
  </div>
</Layout>

