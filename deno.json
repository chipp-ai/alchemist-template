{
  "$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",
  "tasks": {
    "dev": "ALCHEMIST_DEV_ROUTES=1 deno run --env --watch --allow-net --allow-env --allow-read --allow-write --allow-ffi --allow-sys main.ts",
    "start": "deno run --env --allow-net --allow-env --allow-read --allow-ffi --allow-sys main.ts",
    "check": "deno check main.ts",
    "test:clean-schemas": "deno run --env --allow-net --allow-env --allow-read db/clean-test-schemas.ts",
    "test": "deno task test:clean-schemas && TEST_PARALLEL_ISOLATION=1 deno test --parallel --env --no-check --allow-all src/__tests__/",
    "test:fast": "deno task test:clean-schemas && TEST_PARALLEL_ISOLATION=1 deno test --parallel --env --no-check --allow-all src/__tests__/routes/ src/__tests__/services/",
    "test:watch": "deno task test:clean-schemas && TEST_PARALLEL_ISOLATION=1 deno test --env --no-check --watch --allow-all src/__tests__/",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "db:migrate": "deno run --env --allow-net --allow-env --allow-read --allow-write=.scratch/logs db/migrate.ts"
  },
  "imports": {
    "@/": "./src/",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/testing": "jsr:@std/testing@^1.0.0",
    "@std/testing/bdd": "jsr:@std/testing@^1.0.0/bdd",
    "hono": "npm:hono@^4.6.0",
    "hono/cookie": "npm:hono@^4.6.0/cookie",
    "hono/cors": "npm:hono@^4.6.0/cors",
    "hono/logger": "npm:hono@^4.6.0/logger",
    "hono/secure-headers": "npm:hono@^4.6.0/secure-headers",
    "hono/timing": "npm:hono@^4.6.0/timing",
    "hono/compress": "npm:hono@^4.6.0/compress",
    "hono/deno": "npm:hono@^4.6.0/deno",
    "hono/streaming": "npm:hono@^4.6.0/streaming",
    "hono/factory": "npm:hono@^4.6.0/factory",
    "hono/body-limit": "npm:hono@^4.6.0/body-limit",
    "hono/http-exception": "npm:hono@^4.6.0/http-exception",
    "@hono/zod-validator": "npm:@hono/zod-validator@^0.4.0",
    "zod": "npm:zod@^3.23.0",
    "zod-to-json-schema": "npm:zod-to-json-schema@^3.23.0",
    "xlsx": "npm:xlsx@^0.18.5",
    "kysely": "npm:kysely@^0.27.4",
    "kysely-postgres-js": "jsr:@byzanteam/kysely-deno-postgres-dialect",
    "postgres": "npm:postgres@3.4.8",
    "arctic": "npm:arctic@^2.0.0",
    "redis": "https://deno.land/x/redis@v0.32.4/mod.ts",
    "stripe": "npm:stripe@^17.0.0",
    "jose": "npm:jose@^5.0.0",
    "date-fns": "npm:date-fns@^3.0.0",
    "nodemailer": "npm:nodemailer@^6.0.0"
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window", "deno.unstable"]
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false,
    "proseWrap": "preserve"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "exclude": [
        "no-unused-vars",
        "require-await",
        "no-explicit-any",
        "no-window",
        "no-window-prefix",
        "no-unversioned-import",
        "prefer-const",
        "no-control-regex"
      ]
    },
    "exclude": ["web/", "tools/"]
  },
  "nodeModulesDir": "none"
}
